# ============================================================
# SkyWays Airlines — Docker Compose environment variables
# ============================================================
# Copy this file to .env, fill in real secrets, then run:
#   docker compose up -d
#
# NEVER commit the populated .env file to version control.
# ============================================================

# ── PostgreSQL superuser ─────────────────────────────────────
POSTGRES_USER=skyways_admin
POSTGRES_PASSWORD=skyways_admin_pass

# ── Per-service DB credentials (must match docker/init-db.sql) ──
DB_USER=skyways
DB_PASS=skyways_pass

# ── Eureka Registry ──────────────────────────────────────────
EUREKA_USER=eureka
EUREKA_PASSWORD=secret

# ── JWT ──────────────────────────────────────────────────────
# Minimum 32 chars for HS256; use a random 64-char value in production
JWT_SECRET=skyways-jwt-super-secret-key-change-me-in-production

# ── Spring Cloud Config Git backend ──────────────────────────
GIT_URI=https://github.com/skyways/skyways-config-repo
GIT_USERNAME=
GIT_PASSWORD=

# ── External API keys (replace with real values) ─────────────
STRIPE_SECRET_KEY=sk_test_changeme
SENDGRID_API_KEY=SG.changeme
SKYSCANNER_API_KEY=changeme
GDS_API_KEY=changeme
TRIPLE_DES_KEY=skyways-3des-24byte-key!!

# ── GCP Secret Manager ───────────────────────────────────────
GCP_PROJECT_ID=skyways-airlines-prod

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092

# ── ELK ──────────────────────────────────────────────────────
ENVIRONMENT=docker
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5000