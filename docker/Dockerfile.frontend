# â”€â”€ Stage 1: Build â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
FROM --platform=linux/amd64 node:20-alpine AS builder
WORKDIR /app

# Install dependencies first (layer-cached until package.json changes)
COPY package.json package-lock.json* ./
RUN npm ci --prefer-offline

# Copy source and build. VITE_API_BASE_URL is intentionally empty so that
# all /api/v1/... paths are relative to the page origin; nginx proxies them
# to the API gateway at runtime.
COPY . .
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

# â”€â”€ Stage 2: Runtime (nginx) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
FROM --platform=linux/amd64 nginx:1.27-alpine
RUN addgroup -S skyways && adduser -S skyways -G skyways

# Custom nginx config (SPA routing + API proxy)
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# nginx runs as root by default to bind 80; switch to non-root via nginx worker process
CMD ["nginx", "-g", "daemon off;"]