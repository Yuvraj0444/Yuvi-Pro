# ============================================================
# SkyWays Airlines — Local Development Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# On Windows: set each variable in your terminal with:
#   set VARIABLE_NAME=value
# Or permanently via: System Properties → Environment Variables
# ============================================================

# ── 1. Stripe (Payment Gateway) ──────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Use test key (sk_test_...) for local dev — never sk_live_ locally
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY

# ── 2. SendGrid (Email) ──────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
# Click "Create API Key" → Full Access → Copy the SG.xxx key
SENDGRID_API_KEY=SG.REPLACE_WITH_YOUR_KEY

# ── 3. Skyscanner via RapidAPI ───────────────────────────────
# Get from: https://rapidapi.com/skyscanner/api/skyscanner-flight-search
# Subscribe to the free tier → Dashboard → "X-RapidAPI-Key"
SKYSCANNER_API_KEY=REPLACE_WITH_YOUR_RAPIDAPI_KEY

# ── 4. GDS API Key ───────────────────────────────────────────
# Get from your GDS provider (Amadeus, Sabre, Travelport).
# Amadeus free sandbox: https://developers.amadeus.com/register
# After registering, copy the API Key from My Apps
GDS_API_KEY=REPLACE_WITH_YOUR_GDS_KEY

# ── 5. Triple-DES Encryption Key ─────────────────────────────
# MUST be exactly 24 characters (192-bit key for 3-DES).
# Generate with one of these commands:
#   PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 24 | % {[char]$_})
#   Linux/Mac:  openssl rand -base64 18 | head -c 24
# Example output: aBcDeFgHiJkLmNoPqRsTuVwX  (exactly 24 chars)
TRIPLE_DES_KEY=REPLACE_WITH_24_CHAR_KEY_HERE

# ── 6. JWT Secret ─────────────────────────────────────────────
# Any long random string (256-bit = 32+ chars recommended).
# Generate with one of these commands:
#   PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 48 | % {[char]$_})
#   Linux/Mac:  openssl rand -hex 32
# Example output: a9f3c2e1b8d47f6a1e9c3b5d8f2a4e7c  (64 hex chars)
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# ── Database passwords (only needed if you change seed-db.sql defaults) ──
# Default seed-db.sql creates the 'skyways' user with password 'skyways_pass'
# These match the K8s secrets in k8s/secrets/app-secrets.yaml
USER_DB_PASS=skyways_pass
FLIGHT_DB_PASS=skyways_pass
BOOKING_DB_PASS=skyways_pass
PAYMENT_DB_PASS=skyways_pass
SAGA_DB_PASS=skyways_pass

# ── Eureka credentials ────────────────────────────────────────
# Must match eureka.client.service-url in each service's application.yml
EUREKA_PASSWORD=secret

# ── GCP (only needed for Kubernetes production deployment) ────
GCP_PROJECT_ID=skyways-airlines-prod